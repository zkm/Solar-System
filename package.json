{
  "name": "solar-system",
  "version": "2.0.0",
  "repository": "git@github.com:zkm/Solar-System.git",
  "author": "Zach Schneider <me@zachschneider.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.17.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "happy-dom": "^21.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,css,json,html}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "corepack": "^0.35.0"
  }
}
